
SELECT * FROM chargers;
SELECT * FROM sessions;
SELECT * FROM users;

-- LEVEL 1

-- Question 1: Number of users with sessions

SELECT
    COUNT(DISTINCT user_id) AS 'Numero de usuarios'
FROM sessions;


-- Question 2: Number of chargers used by user with id 1

SELECT
    COUNT(DISTINCT charger_id) AS 'Numero de cargadores'
FROM sessions
WHERE user_id = '1';

-- LEVEL 2

-- Question 3: Number of sessions per charger type (AC/DC):

SELECT
    charger_id As 'ID Cargadores',
    COUNT(*) AS 'Numero de sesiones'
FROM sessions
GROUP BY charger_id;

SELECT 
    chargers.type AS 'Tipo',
    COUNT(sessions.id) AS 'Numero de sesiones'
FROM sessions
JOIN chargers ON sessions.charger_id = chargers.id
GROUP BY chargers.type;

-- Question 4: Chargers being used by more than one user

SELECT
    charger_id AS 'ID Cargadores',
    COUNT(DISTINCT user_id) AS 'Numero de usuarios'
FROM sessions
GROUP BY charger_id
HAVING COUNT(DISTINCT user_id) > 1;

-- Question 5: Average session time per charger

SELECT 
    charger_id AS 'ID Cargadores',
    AVG((julianday(end_time)-julianday(start_time))*24*60) AS 'Tiempo promedio'
FROM sessions
GROUP BY charger_id;

-- LEVEL 3

-- Question 6: Full username of users that have used more than one charger in one day (NOTE: for date only consider start_time) 

SELECT
    users.name|| ' ' ||users.surname AS 'Nombre completo',
    strftime('%d', start_time) AS Dia,
    COUNT(*) AS Contador
FROM sessions
LEFT JOIN users ON sessions.user_id = users.id
GROUP BY
    user_id,
    dia
HAVING contador > 1;

-- Question 7: Top 3 chargers with longer sessions

SELECT
    chargers.label AS 'Etiqueta',
    ROUND((julianday(end_time)-julianday(start_time))*24*60) AS 'Tiempo de sesion (s)',
    RANK() OVER(ORDER BY (julianday(end_time)-julianday(start_time))*24*60 DESC) AS rank
FROM sessions
LEFT JOIN chargers ON sessions.charger_id = chargers.id
LIMIT 3; 

-- Question 8: Average number of users per charger (per charger in general, not per charger_id specifically)

SELECT 
    AVG(user_count) AS 'promedio de usuarios por cargador'
FROM (
    SELECT 
        charger_id, 
        COUNT(DISTINCT user_id) AS user_count
    FROM Sessions
    GROUP BY charger_id
);

-- Question 9: Top 3 users with more chargers being used

SELECT 
    user_id AS 'ID Usuario', 
    COUNT(DISTINCT charger_id) AS num_cargadores
FROM sessions
GROUP BY user_id
ORDER BY num_cargadores DESC
LIMIT 3;

-- LEVEL 4

-- Question 10: Number of users that have used only AC chargers, DC chargers or both

SELECT 
    type AS 'Tipo',
    COUNT(DISTINCT user_id) AS 'Numero de usuarios'
FROM (
    SELECT 
        user_id,
        CASE 
            WHEN COUNT(DISTINCT type) = 1 THEN MIN(type)
            ELSE 'Ambos'
        END AS type
    FROM sessions
    JOIN chargers ON sessions.charger_id = chargers.id
    GROUP BY user_id
)
GROUP BY type;

-- Question 11: Monthly average number of users per charger

SELECT 
    charger_id AS 'ID Cargador', 
    AVG(user_count) AS 'Promedio de usuarios por mes'
FROM (
    SELECT 
        charger_id, 
        strftime('%Y-%m', start_time) AS mes,
        COUNT(DISTINCT user_id) AS user_count
    FROM sessions
    GROUP BY charger_id,
             mes
)
GROUP BY charger_id;

-- Question 12: Top 3 users per charger (for each charger, number of sessions)

WITH RankedSessions AS (
    SELECT 
        user_id, 
        charger_id, 
        COUNT(*) AS session_count,
        ROW_NUMBER() OVER (PARTITION BY charger_id ORDER BY COUNT(*) DESC) AS rank
    FROM Sessions
    GROUP BY user_id, charger_id
)

SELECT 
    user_id, 
    charger_id, 
    session_count
FROM RankedSessions
WHERE rank <= 3;


-- LEVEL 5

-- Question 13: Top 3 users with longest sessions per month (consider the month of start_time)

WITH MonthlySessionDurations AS (
    SELECT 
        user_id,
        strftime('%Y-%m', start_time) AS month,
        SUM(strftime('%s', end_time) - strftime('%s', start_time)) AS total_duration
    FROM Sessions
    GROUP BY user_id, month
)

SELECT 
    user_id, 
    month, 
    total_duration
FROM MonthlySessionDurations
ORDER BY total_duration DESC
LIMIT 3;
    
